# ==============================================================================
# Masareefy (مصاريفي) — Environment Configuration Template
# Copy this file to .env.local and populate the values.
# DO NOT commit .env.local to version control.
# ==============================================================================

# --- Database Connections (Supabase PostgreSQL) ---
# Supabase Transaction Pooler (port 6543, pgbouncer/supavisor mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Direct Connection (port 5432, for migrations and drizzle-kit push)
DIRECT_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Telegram Bot Configuration ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- Google Gemini AI ---
# Obtain free API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# --- Cryptographic Security (At Rest Encryption) ---
# 32-byte master key (64 hex characters). Generate via: openssl rand -hex 32
# KEEP THIS BACKED UP SECURELY. If lost, encrypted expense descriptions cannot be decrypted.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=k1

# --- Webhook Protection ---
# Secret token passed by Telegram in X-Telegram-Bot-Api-Secret-Token
# Generate via: openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Production Deployment URLs (Vercel) ---
WEBHOOK_URL=https://your-app.vercel.app/api/webhook
MINI_APP_URL=https://your-app.vercel.app
